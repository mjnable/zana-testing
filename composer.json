{
    "name": "zana/testing",
    "description": "Testing helpers and utilities for Zana applications",
    "type": "library",
    "keywords": ["zana", "testing", "test", "phpunit"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Testing\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}


{
    "name": "mj-zana/testing",
    "description": "Test Zana applications: boot them for tests, send HTTP requests and run commands in memory, record events and enforce architecture rules",
    "type": "library",
    "keywords": ["zana", "testing", "phpunit", "architecture"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/console": "^2.0",
        "mj-zana/core": "^2.0",
        "mj-zana/http": "^2.0",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^11.5",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Testing\\Tests\\": "tests/"
        },
        "files": ["tests/Fixtures.php"]
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.0.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.0.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.0.0" } } },
        { "type": "path", "url": "../zana-ddd", "options": { "symlink": true, "versions": { "mj-zana/ddd": "2.0.0" } } },
        { "type": "path", "url": "../zana-http", "options": { "symlink": true, "versions": { "mj-zana/http": "2.0.0" } } },
        { "type": "path", "url": "../zana-console", "options": { "symlink": true, "versions": { "mj-zana/console": "2.0.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
